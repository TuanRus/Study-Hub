{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=studyhub.db"
  },
  "Jwt": {
    "Issuer": "StudyHub",
    "Audience": "StudyHub.Web",
    "Key": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "Cors": {
    "Origins": [ "http://127.0.0.1:5500", "http://localhost:5500" ]
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 10,
    "PublicProfilePermitsPerMinute": 120
  },
  "Admin": {
    "SuperAdmins": []
  },
  "Frontend": {
    "Enabled": true,
    "RootPath": "../../../frontend"
  },
  "Database": {
    "MigrateOnStartup": true
  }
}
