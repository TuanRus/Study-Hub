# =====================================================================
# Study Hub – .gitignore
# =====================================================================

# ---------------------------------------------------------------------
# .NET build output / Kết quả build của .NET
# ---------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Ll]og/
[Ll]ogs/
publish/
artifacts/
*.nupkg
*.snupkg

# Test results & coverage / Kết quả test và độ phủ
TestResults/
*.trx
coverage/
coverage*.json
coverage*.xml
*.coverage
*.coveragexml

# ---------------------------------------------------------------------
# SQLite database (created at runtime) / Database SQLite (tự tạo khi chạy)
# ---------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------
# Secrets & local config / Bí mật và cấu hình máy cá nhân
# ---------------------------------------------------------------------
secrets.json
appsettings.*.local.json
appsettings.Local.json
appsettings.Production.json
.env
.env.*
*.pfx
*.pem
*.key

# ---------------------------------------------------------------------
# IDEs & editors / IDE và trình soạn thảo
# ---------------------------------------------------------------------
# Visual Studio
.vs/
*.user
*.suo
*.userprefs
*.rsuser
*.ntvs*
*.njsproj

# JetBrains Rider / WebStorm
.idea/
*.sln.iml
*.DotSettings.user

# VS Code (keep shared recommendations / giữ lại file gợi ý dùng chung)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.history/

# Vim / Emacs
*.sw?
*~
\#*\#

# ---------------------------------------------------------------------
# Frontend tooling (if you ever add npm) / Công cụ frontend (nếu dùng npm)
# ---------------------------------------------------------------------
node_modules/
.npm/
dist/
.cache/
npm-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------
# Logs & temp files / Log và file tạm
# ---------------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak

# ---------------------------------------------------------------------
# OS files / File hệ điều hành
# ---------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
.directory
.Trash-*

# ---------------------------------------------------------------------
# Personal deploy notes / Ghi chú deploy cá nhân
# ---------------------------------------------------------------------
docs/DEPLOY-ZIMAOS.md

# ---------------------------------------------------------------------
# Docker deployment files / File deploy bằng Docker
# ---------------------------------------------------------------------
Dockerfile
docker-compose.yml
.dockerignore
.env.example
deploy/
